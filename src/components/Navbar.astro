---
interface Props {
  active?: 'projects' | 'contact' | 'articles' | 'values';
}
const { active } = Astro.props;
---

<nav class="navbar">
  <div class="navbar__inner">
    <a href="/" class="nav-logo">
      <span class="nav-logo__mark" aria-hidden="true">&#10022;</span>
      Alexander Luo
    </a>
    <div class="nav-links">
      <div class="nav-links__group" role="tablist" aria-label="Sections">
        <a href="/" role="tab" class:list={{ 'nav-active': active === 'contact' || !active }}>Contact</a>
        <a href="/projects" role="tab" class:list={{ 'nav-active': active === 'projects' }}>Projects</a>
        <a href="/articles" role="tab" class:list={{ 'nav-active': active === 'articles' }}>Articles</a>
        <a href="/values" role="tab" class:list={{ 'nav-active': active === 'values' }}>Values</a>
      </div>
      <a href="https://github.com/aluoty" class="nav-github" target="_blank" rel="noreferrer">GitHub</a>
    </div>
  </div>
</nav>
