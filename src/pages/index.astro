---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { Starfield } from '../components/Starfield';
import { Planets } from '../components/Planets';
---

<Layout>
  <Starfield client:visible />
  <Planets />
  <div class="nebula nebula--one" aria-hidden="true" />
  <div class="nebula nebula--two" aria-hidden="true" />

  <div class="page" id="page-root">
    <Navbar active="contact" />

    <main class="content-view">
      <section class="hero-section">
        <div class="section-label">Alexander Luo</div>
        <div class="terminal-badge">Hi! It&apos;s me Alexander Luo.</div>
        <h1 class="hero-title">Computer Science &amp; Applied Programming</h1>
        <p class="hero-subtitle">
          I&apos;m a primary school student designing games and tools on my Linux machine.
        </p>
        <div class="cta-group">
          <button id="copy-email" class="btn-primary">Contact me via Gmail</button>
          <a href="https://wa.me/6583380910" class="btn-whatsapp" target="_blank" rel="noreferrer">
            Contact me via WhatsApp
          </a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>Built with Astro + React + TypeScript // Hosted via Cloudflare Edge Network</p>
    </footer>
  </div>

  <script is:inline>
    document.getElementById('copy-email')?.addEventListener('click', function() {
      navigator.clipboard.writeText('alexanderluo0910@gmail.com').then(function() {
        var t = this;
        t.textContent = 'Copied!';
        setTimeout(function() { t.textContent = 'Contact me via Gmail'; }, 2000);
      }.bind(this));
    });
  </script>
</Layout>
