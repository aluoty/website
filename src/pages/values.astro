---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import { Starfield } from '../components/Starfield';
import { Planets } from '../components/Planets';

const values = [
  {
    title: 'Build to learn',
    description:
      'I learn best by making things — tools, and experiments on my Linux machine.',
  },
  {
    title: 'Curiosity first',
    description:
      'Everything I build starts with a question. I wonder how things work, then I try to make them myself.',
  },
  {
    title: 'Share what works',
    description:
      'Projects are meant to be explored, and improved in the open.',
  },
  {
    title: 'Be a questioner',
    description:
       'I question everything, I never accept things that I do not understand or have no evidence.',
  },
];
---

<Layout title="Values — Alexander Luo">
  <Starfield client:visible />
  <Planets />

  <div class="page" id="page-root">
    <Navbar active="values" />

    <main class="content-view">
      <section class="values-section">
        <h2 class="section-title">Values</h2>
        <div class="values-grid">
          {values.map((value) => (
            <div class="value-card">
              <h3>{value.title}</h3>
              <p>{value.description}</p>
            </div>
          ))}
        </div>
      </section>
    </main>

    <footer class="footer">
      <p>Built with Astro + React + TypeScript // Hosted via Cloudflare Edge Network</p>
    </footer>
  </div>
</Layout>
